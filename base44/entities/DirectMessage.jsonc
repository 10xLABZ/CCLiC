{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "from_user_id": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "from_username": {
      "type": "string"
    },
    "to_username": {
      "type": "string"
    },
    "from_profile_image_url": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    },
    "thread_id": {
      "type": "string",
      "description": "Sorted pair of user IDs joined by _ to identify the conversation"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "from_user_id",
    "to_user_id",
    "message",
    "timestamp",
    "thread_id"
  ]
}