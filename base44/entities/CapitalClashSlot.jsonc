      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "profile_image_url": {
      "type": "string"
    },
    "player_level": {
      "type": "integer"
    },
    "atk": {
      "type": "number"
    },
    "def": {
      "type": "number"
    },
    "slot_number": {
      "type": "integer",
      "description": "1-100"
    },
    "cycle_start": {
      "type": "number",
